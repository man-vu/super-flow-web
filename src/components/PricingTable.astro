---
const rows = [
  { feature: 'Words per week',                free: '2,000',          pro: 'Unlimited' },
  { feature: 'Transcription engine',          free: 'Local Whisper',  pro: 'Deepgram cloud + Whisper fallback' },
  { feature: 'Text cleanup',                  free: 'Rule-based',     pro: 'GPT-4o-mini style transfer' },
  { feature: 'Custom dictionary + snippets',  free: 'yes',            pro: 'yes' },
  { feature: 'Voice snippets',                free: 'yes',            pro: 'yes' },
  { feature: 'IDE-aware coding mode',         free: 'yes',            pro: 'yes' },
  { feature: 'ElevenLabs / Piper read-aloud', free: '—',              pro: 'yes' },
  { feature: 'Polish hotkey (Ctrl+Shift+P)',  free: '—',              pro: 'yes' },
  { feature: 'Priority support',              free: '—',              pro: 'yes' },
]

const cellClass = (v: string): string =>
  v === 'yes' ? 'cell-yes' : v === '—' ? 'cell-no' : 'cell-text'
---
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="feature-col">Feature</th>
        <th>Free</th>
        <th class="pro-col">Pro <span class="price">$15/mo</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr data-reveal>
          <td class="feature-cell">{row.feature}</td>
          <td class={cellClass(row.free)}>{row.free === 'yes' ? '+' : row.free}</td>
          <td class={`pro-col ${cellClass(row.pro)}`}>{row.pro === 'yes' ? '+' : row.pro}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .table-wrap {
    margin-top: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th, td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    font-weight: 500;
    background: var(--bg-elevated);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  thead th.pro-col {
    color: var(--accent);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.12) 0%, rgba(99, 102, 241, 0.04) 100%);
  }
  thead th .price {
    margin-left: 8px;
    color: var(--text-tertiary);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.78rem;
  }
  td.pro-col { background: rgba(99, 102, 241, 0.04); color: var(--text); }
  td.feature-cell { color: var(--text); font-weight: 500; }
  td.cell-yes {
    font-family: var(--font-mono);
    color: var(--lime);
    font-weight: 600;
  }
  td.cell-no { color: var(--text-tertiary); font-family: var(--font-mono); }
  tr:last-child td { border-bottom: none; }

  /* Mobile: collapse the table into a stack of cards. Each row becomes
     its own block with the feature name as the title and Free/Pro
     values labeled side-by-side. Avoids the 80px-wide cell crush. */
  @media (max-width: 640px) {
    .table-wrap { border-radius: var(--radius-md); }
    table, thead, tbody, tr, td, th { display: block; }
    thead { display: none; }
    tr {
      padding: var(--space-4);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    tr:last-child { border-bottom: none; }
    td {
      padding: 0;
      border: none;
      background: transparent !important;
      color: var(--text);
    }
    td.feature-cell {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-tertiary);
      margin-bottom: var(--space-3);
      font-weight: 500;
    }
    td:not(.feature-cell) {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 6px 0;
      font-size: 0.95rem;
    }
    td:not(.feature-cell)::before {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      color: var(--text-tertiary);
      text-transform: uppercase;
      margin-right: var(--space-3);
    }
    td:nth-of-type(2)::before { content: 'free'; }
    td.pro-col::before { content: 'pro'; color: var(--accent); }
  }
</style>
