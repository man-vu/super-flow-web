---
const rows = [
  { feature: 'Words per week',                free: '2,000',          pro: 'Unlimited' },
  { feature: 'Transcription engine',          free: 'Local Whisper',  pro: 'Deepgram cloud + Whisper fallback' },
  { feature: 'Text cleanup',                  free: 'Rule-based',     pro: 'GPT-4o-mini style transfer' },
  { feature: 'Custom dictionary + snippets',  free: 'yes',            pro: 'yes' },
  { feature: 'Voice snippets',                free: 'yes',            pro: 'yes' },
  { feature: 'IDE-aware coding mode',         free: 'yes',            pro: 'yes' },
  { feature: 'ElevenLabs / Piper read-aloud', free: '—',              pro: 'yes' },
  { feature: 'Polish hotkey (Ctrl+Shift+P)',  free: '—',              pro: 'yes' },
  { feature: 'Priority support',              free: '—',              pro: 'yes' },
]

const cellClass = (v: string): string =>
  v === 'yes' ? 'cell-yes' : v === '—' ? 'cell-no' : 'cell-text'
---
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="feature-col">Feature</th>
        <th>Free</th>
        <th class="pro-col">Pro <span class="price">$15/mo</span></th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          <td class="feature-cell">{row.feature}</td>
          <td class={cellClass(row.free)}>{row.free === 'yes' ? '+' : row.free}</td>
          <td class={`pro-col ${cellClass(row.pro)}`}>{row.pro === 'yes' ? '+' : row.pro}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .table-wrap {
    margin-top: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th, td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    font-weight: 500;
    background: var(--bg-elevated);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  thead th.pro-col {
    color: var(--accent);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.12) 0%, rgba(99, 102, 241, 0.04) 100%);
  }
  thead th .price {
    margin-left: 8px;
    color: var(--text-tertiary);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.78rem;
  }
  td.pro-col { background: rgba(99, 102, 241, 0.04); color: var(--text); }
  td.feature-cell { color: var(--text); font-weight: 500; }
  td.cell-yes {
    font-family: var(--font-mono);
    color: var(--lime);
    font-weight: 600;
  }
  td.cell-no { color: var(--text-tertiary); font-family: var(--font-mono); }
  tr:last-child td { border-bottom: none; }
</style>
