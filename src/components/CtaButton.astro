---
interface Props { href: string; variant?: 'primary' | 'secondary' }
const { href, variant = 'primary' } = Astro.props
---
<a href={href} class={`cta cta-${variant}`}>
  <slot />
  <span class="arrow" aria-hidden="true">→</span>
</a>
<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    transition: background 180ms ease, color 180ms ease, transform 100ms ease, box-shadow 180ms ease;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .cta:active { transform: translateY(1px); }
  .cta .arrow {
    transition: transform 180ms ease;
    color: inherit;
  }
  .cta:hover .arrow { transform: translateX(3px); }

  .cta-primary {
    background: var(--accent);
    color: #fff !important;
    border-color: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
  }
  .cta-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff !important;
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .cta-secondary {
    background: transparent;
    color: var(--text) !important;
    border-color: var(--border-strong);
  }
  .cta-secondary:hover {
    background: var(--surface);
    color: var(--text) !important;
    border-color: var(--text-tertiary);
  }
</style>
