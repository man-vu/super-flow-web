---
const base = import.meta.env.BASE_URL
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand-col">
      <div class="footer-brand">super-flow</div>
      <p class="footer-tag">Dictate anywhere on Windows. Polished by AI.</p>
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        v0.1.0 · all systems normal
      </div>
    </div>
    <div>
      <div class="footer-heading">Product</div>
      <a href={base}>Home</a>
      <a href={`${base}pricing/`}>Pricing</a>
      <a href={`${base}faq/`}>FAQ</a>
    </div>
    <div>
      <div class="footer-heading">Company</div>
      <a href={`${base}about/`}>About</a>
      <a href="https://github.com/man-vu/super-flow-releases">GitHub</a>
    </div>
    <div>
      <div class="footer-heading">Legal</div>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}terms/`}>Terms</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Super Flow</span>
    <span class="footer-built">Built with care, not templates.</span>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-8);
    padding: var(--space-7) 0 var(--space-5);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-6);
  }
  .footer-brand-col { max-width: 320px; }
  .footer-brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .footer-tag {
    color: var(--text-tertiary);
    margin: 0 0 var(--space-3);
    font-size: 0.9rem;
  }
  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 8px var(--lime);
  }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
  }
  .site-footer a {
    display: block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-2);
    transition: color 150ms ease;
  }
  .site-footer a:hover { color: var(--text); }
  .footer-bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text-tertiary);
    font-size: 0.82rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-built {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-tertiary);
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand-col { grid-column: span 2; max-width: none; }
  }
</style>
