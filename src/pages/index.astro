<style is:global>
  #watch { scroll-margin-top: 84px; }
  #watch .vid-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 44px; }
  #watch .vid { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  #watch .vid-player { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  #watch .vid-cap { padding: 18px 20px 20px; }
  #watch .vid-cap b { display: block; font-size: 1.05rem; color: var(--ink); letter-spacing: -0.01em; }
  #watch .vid-cap span { display: block; margin-top: 5px; font-size: .92rem; line-height: 1.4; color: var(--muted); }
  /* featured dictation card: full width, video + copy side by side */
  #watch .vid--lead { grid-column: 1 / -1; display: grid; grid-template-columns: 1.55fr 1fr; align-items: stretch; }
  #watch .vid--lead .vid-cap { display: flex; flex-direction: column; justify-content: center; padding: 30px 38px; }
  #watch .vid--lead .vid-cap b { font-size: 1.6rem; margin-top: 8px; }
  #watch .vid--lead .vid-cap span { font-size: 1rem; margin-top: 10px; line-height: 1.5; }
  #watch .vid-tag { align-self: flex-start; font-family: var(--font-mono, monospace); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--border); border-radius: 100px; padding: 4px 11px; }
  @media (max-width: 860px) {
    #watch .vid-grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    #watch .vid--lead { grid-template-columns: 1fr; }
  }
</style>

