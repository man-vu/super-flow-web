<!-- ============ FEATURES BENTO ============ -->
<section class="band container" id="features">
  <div class="section-head">
    <span class="eyebrow">what it does</span>
    <h2 class="section-title">Dictation is just<br>the start.</h2>
    <p class="lead">One hotkey turns speech into clean text anywhere. Then it keeps going — polishing selections, transcribing meetings, and answering questions about whatever's on your screen.</p>
  </div>

  <div class="bento">
    <!-- big: dictate -->
    <div class="cell col-3 cell-feature" data-reveal>
      <div class="c-eyebrow">● the core loop</div>
      <h3>Press F9. Speak. Done.</h3>
      <p>Tap <kbd>F9</kbd> in any text field and the system types what you say — filler removed, grammar fixed, punctuation added.</p>
      <div class="mini-baf">
        <div class="mini-line before"><span class="mtag">you say</span>so basically um can you send me the the report by friday and uh thanks</div>
        <div class="mini-line after"><span class="mtag">it types</span>Can you send me the report by Friday? Thanks!</div>
      </div>
    </div>

    <!-- big: polish -->
    <div class="cell col-3 cell-feature" data-reveal>
      <div class="c-eyebrow">● rewrite in place</div>
      <h3>Polish anything you've already written.</h3>
      <p>Select messy text in any app, hit the hotkey, get clean prose back in place. Native <kbd>Ctrl</kbd>+<kbd>Z</kbd> undoes it.</p>
      <div class="keys"><kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>P</kbd><span class="cmd-chip">Fix grammar</span><span class="cmd-chip">Make concise</span><span class="cmd-chip">Professional</span></div>
      <div class="cell-spacer"></div>
    </div>

    <!-- meetings -->
    <div class="cell col-2 cell-feature cell-dark" data-reveal>
      <div class="c-eyebrow">● meetings</div>
      <h3>Live meeting transcripts.</h3>
      <p>Auto-transcribe calls in real time. Pin, finalize, and keep version history.</p>
      <div class="mini-transcript">
        <div class="tline"><span class="who">Alex</span><span class="said">Let's ship the beta next Thursday.</span></div>
        <div class="tline"><span class="who">You</span><span class="said">Agreed — I'll own the release notes.</span></div>
      </div>
    </div>

    <!-- flow lens -->
    <div class="cell col-2 cell-feature" data-reveal>
      <div class="c-eyebrow">● flow lens</div>
      <h3>Ask about your screen.</h3>
      <p>A chat that reads your focused window and answers grounded in what's actually there.</p>
      <div class="mini-chat">
        <div class="bubble you">What's this email asking for?</div>
        <div class="bubble ai">A budget sign-off by Friday.</div>
      </div>
    </div>

    <!-- command mode -->
    <div class="cell col-2 cell-feature" data-reveal>
      <div class="c-eyebrow">● command mode</div>
      <h3>Talk to your text.</h3>
      <p>Highlight, hold the key, and tell it what to do with the selection.</p>
      <div>
        <span class="cmd-chip">“translate to Spanish”</span>
        <span class="cmd-chip">“make it two sentences”</span>
        <span class="cmd-chip">“fix grammar”</span>
      </div>
    </div>

    <!-- small trio -->
    <div class="cell col-2" data-reveal>
      <div class="c-eyebrow">● snippets</div>
      <h3>Voice snippets.</h3>
      <p>Say a trigger phrase, get a full signature, address, or boilerplate.</p>
    </div>
    <div class="cell col-2" data-reveal>
      <div class="c-eyebrow">● dictionary</div>
      <h3>Custom dictionary.</h3>
      <p>Teach it your names, jargon, and acronyms once. Import a CSV in bulk.</p>
    </div>
    <div class="cell col-2" data-reveal>
      <div class="c-eyebrow">● for developers</div>
      <h3>IDE-aware coding.</h3>
      <p>In code, it speaks <kbd>camelCase</kbd>, <kbd>snake_case</kbd>, and your file context.</p>
    </div>
  </div>
</section>

