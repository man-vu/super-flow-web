<!-- ============ PRIVACY ============ -->
<section class="band dark-band" id="privacy">
  <div class="container privacy-grid">
    <div>
      <span class="eyebrow">privacy &amp; security</span>
      <h2 class="section-title" style="margin-top:18px">Your voice never has to leave your machine.</h2>
      <p class="lead">On the Free plan, transcription runs entirely on-device with local Whisper. No cloud round-trip, no account required to start.</p>
      <div class="priv-points">
        <div class="priv-point"><span class="pn">01</span><div><h3>On-device transcription</h3><p>Local Whisper turns speech into text without the audio ever touching a server.</p></div></div>
        <div class="priv-point"><span class="pn">02</span><div><h3>Privacy Mode</h3><p>Flip it on and nothing is written to disk — no history rows, no archived audio. The session leaves no trace.</p></div></div>
        <div class="priv-point"><span class="pn">03</span><div><h3>You hold the keys</h3><p>Going cloud for speed is opt-in. Bring your own API key — we're not a middleman for your data.</p></div></div>
      </div>
    </div>
    <div class="priv-visual">
      <div class="toggle-row"><div class="tr-label"><b>Privacy Mode</b><span>Don't save history or audio</span></div><div class="switch"></div></div>
      <div class="toggle-row"><div class="tr-label"><b>Local Whisper</b><span>On-device transcription</span></div><div class="switch"></div></div>
      <div class="toggle-row"><div class="tr-label"><b>Cloud speed (Deepgram)</b><span>Opt-in, your API key</span></div><div class="switch off"></div></div>
      <div class="toggle-row"><div class="tr-label"><b>Store recordings</b><span>Keep audio archive on disk</span></div><div class="switch off"></div></div>
      <div class="priv-chip-row">
        <span class="priv-chip">No account to start</span>
        <span class="priv-chip">Local-first</span>
        <span class="priv-chip">Signed installer</span>
        <span class="priv-chip">Open releases</span>
      </div>
    </div>
  </div>
</section>

