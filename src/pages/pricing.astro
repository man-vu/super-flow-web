---
import Base from '../layouts/Base.astro'
import PricingTable from '../components/PricingTable.astro'
import CtaButton from '../components/CtaButton.astro'

const downloadHref = 'https://github.com/man-vu/super-flow-releases/releases/latest'

const faq = [
  { q: 'Can I cancel any time?',           a: 'Yes. Pro is month-to-month. Cancel from your billing portal and you keep Pro features until the end of your current period.' },
  { q: 'Do you offer refunds?',            a: 'Within 14 days of upgrading, email us and we will refund your most recent payment, no questions.' },
  { q: 'What payment methods?',            a: 'All major credit and debit cards via Stripe. We never see or store your card details.' },
  { q: 'Is there a team plan?',            a: 'Not yet. If you need 5+ seats for your team, write to us and we will work something out.' },
]
---
<Base title="Pricing — Super Flow">
  <main class="container section">
    <header class="page-header">
      <span class="eyebrow">pricing</span>
      <h1>Free to start. Pro when you need it.</h1>
      <p>Upgrade when you want cloud transcription, polished AI cleanup, or read-aloud. Cancel anytime.</p>
    </header>

    <PricingTable />

    <div class="cta-row">
      <CtaButton href={downloadHref}>Download free</CtaButton>
    </div>

    <section class="pricing-faq">
      <span class="eyebrow">common questions</span>
      <h2>Before you ask.</h2>
      <dl>
        {faq.map(item => (
          <>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </>
        ))}
      </dl>
    </section>
  </main>
</Base>

<style>
  .page-header { margin-bottom: var(--space-5); max-width: 720px; }
  .page-header p { font-size: 1.05rem; }
  .cta-row { display: flex; margin-top: var(--space-5); }
  .pricing-faq { margin-top: var(--space-8); }
  dl {
    display: grid;
    gap: 1px;
    margin-top: var(--space-4);
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  dt {
    background: var(--surface);
    padding: var(--space-4) var(--space-4) var(--space-2);
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }
  dd {
    background: var(--surface);
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
