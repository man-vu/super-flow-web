---
import Base from '../layouts/Base.astro'

const faq = [
  {
    q: 'What is Super Flow?',
    a: 'A voice-to-text dictation app for Windows. Press F9 in any text field, speak, and Super Flow types polished text — filler words removed, grammar fixed, punctuation added.'
  },
  {
    q: 'Which operating systems are supported?',
    a: 'Windows 10 and 11 today. macOS is on the roadmap.'
  },
  {
    q: 'Which hotkey triggers dictation?',
    a: 'F9 by default. You can change it to any function key or modifier chord in Settings → General.'
  },
  {
    q: 'Does my voice leave my machine?',
    a: 'On the Free tier with Whisper, no — all transcription runs locally. On Pro with Deepgram, audio streams to Deepgram and OpenAI for transcription and cleanup. We never log or store your audio.'
  },
  {
    q: 'What is the difference between Free and Pro?',
    a: 'Free gives you 2,000 words/week with local Whisper + rule-based cleanup. Pro adds Deepgram streaming, GPT-4o-mini style transfer, ElevenLabs read-aloud, and unlimited words for $15/month.'
  },
  {
    q: 'Can I use my own OpenAI or Deepgram API keys?',
    a: 'Yes. Settings → General → Advanced lets you provide your own keys instead of using the Pro-included infrastructure.'
  },
  {
    q: 'How do I cancel my Pro subscription?',
    a: 'From your Stripe billing portal, accessible inside the app under Settings → Account → Billing. Pro features stay active until the end of your current paid period.'
  },
  {
    q: 'Is there a refund policy?',
    a: 'Yes. Within 14 days of upgrading, email us and we will refund your most recent payment in full.'
  },
  {
    q: 'Where is my data stored?',
    a: 'Locally in a SQLite file at %APPDATA%/Super Flow/super-flow.db. Your transcripts, dictionary, snippets, and settings never sync to a server.'
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, with the Whisper transcription engine and rule-based cleanup. Cloud features (Deepgram, GPT-4o-mini, ElevenLabs) require an internet connection.'
  },
  {
    q: 'How do I report a bug?',
    a: 'Open an issue at github.com/man-vu/super-flow-releases or email us — both routes are monitored daily.'
  },
]
---
<Base title="FAQ — Super Flow">
  <main class="container section">
    <header class="page-header">
      <span class="eyebrow">faq</span>
      <h1>Frequently asked questions.</h1>
    </header>
    <div class="faq-list">
      {faq.map((item, i) => (
        <details>
          <summary>
            <span class="q-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="q-text">{item.q}</span>
            <span class="q-toggle" aria-hidden="true">+</span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </main>
</Base>

<style>
  .page-header { margin-bottom: var(--space-6); max-width: 720px; }
  .faq-list {
    max-width: 760px;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  details {
    background: var(--surface);
    padding: var(--space-4);
    transition: background 180ms ease;
  }
  details:hover { background: var(--surface-hover); }
  details[open] { background: var(--surface-hover); }
  summary {
    cursor: pointer;
    color: var(--text);
    font-weight: 500;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  summary::-webkit-details-marker { display: none; }
  .q-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .q-text {
    flex: 1;
    font-size: 1rem;
    line-height: 1.45;
  }
  .q-toggle {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 200ms ease;
  }
  details[open] .q-toggle { transform: rotate(45deg); }
  details p {
    margin: var(--space-3) 0 0 calc(2.5ch + var(--space-3));
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 560px) {
    details p { margin-left: 0; }
  }
</style>
